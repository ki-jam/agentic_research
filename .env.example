# Research Agent configuration — copy to .env and fill in your keys.
# Every value here can also be set as a real environment variable
# (the environment wins over .env).

# ── LLM provider (global default) ──────────────────────────────────
# One of: local, openai, anthropic
PROVIDER=local

# local — llama.cpp / Ollama (OpenAI-compatible endpoint)
LOCAL_MODEL=qwen36_35
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_API_KEY=not-needed

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional proxy/base URL override
ANTHROPIC_BASE_URL=

# ── Models per step (diverse models in one session) ────────────────
# TIP: don't edit this block by hand — run `python run.py models` (or
# menu item 7) to browse the steps, see which model each runs on, and
# change them interactively (it writes these same lines for you).
#
# Each pipeline step — planning, extraction, curation, report — can run
# on its own model and even its own provider, e.g. local extraction +
# Anthropic report. Empty = the step's provider's default model /
# the global PROVIDER. The session-start banner shows what will run.
#
#   local extraction + strong report:
#     PROVIDER=local
#     REPORT_PROVIDER=anthropic
#     REPORT_MODEL=claude-sonnet-5-5
#
#   fast model for the high-volume steps:
#     EXTRACTION_MODEL=fast-7b
#     CURATION_MODEL=fast-7b
PLANNING_MODEL=
EXTRACTION_MODEL=
CURATION_MODEL=
REPORT_MODEL=
PLANNING_PROVIDER=
EXTRACTION_PROVIDER=
CURATION_PROVIDER=
REPORT_PROVIDER=

# ── Search ─────────────────────────────────────────────────────────
# Primary web engine: exa, brave, arxiv, or exa+brave
SEARCH_PRIMARY=exa
EXA_API_KEY=
BRAVE_API_KEY=

# arXiv routing: auto (science vocabulary decides) / web / arxiv / both
SEARCH_FORCE_ARXIV=auto
ARXIV_MAX_RESULTS=10

# GitHub repositories leg (OSS topics): auto / on / off
SEARCH_FORCE_GITHUB=auto
GITHUB_MAX_RESULTS=5
# Optional token raises the rate limit 10 → 30 search req/min
GITHUB_TOKEN=

# Foundational-paper discovery via Exa answer API (one call per plan)
ENABLE_CITATION_DISCOVERY=true

# Cache lifetime in days (0 = never expires)
SEARCH_CACHE_TTL_DAYS=30

# Browser-based content enrichment (Playwright; off by default)
BROWSER_SEARCH_ENABLED=false

# ── Workflow ───────────────────────────────────────────────────────
MAX_ITERATIONS=10
REVIEW_EVERY=5
MIN_FINDINGS=3
READY_COVERAGE_GATE=true
READY_MIN_RESOLUTION=0.5
REFINE_QUERY_THRESHOLD=20
RESEARCH_BASE_DIR=
